{
    "version": "2.0.0",
    "inputs": [
        {
            "id": "test_name",
            "description": "TestName:",
            "default": "new_test",
            "type": "promptString"
        },
    ],
    "tasks": [
        {
            "label": "Create Test",
            "command": "scripts/create_test.sh ${input:test_name}",
            "type": "shell",
            "args": [],
            "group": "build"
        },
        {
            "label": "Build - Release",
            "command": "python3",
            "type": "shell",
            "args": [
                "${workspaceFolder}/scripts/build.py",
                "--type", 
                "Release",
                "--target", 
                "build", 
                "--jobs",
                "10", 
            ],
            "group": "build"
        },
        {
            "label": "Rebuild - Release",
            "command": "python3",
            "type": "shell",
            "args": [
                "${workspaceFolder}/scripts/build.py",
                "--type", 
                "Release",
                "--target", 
                "rebuild", 
                "--jobs",
                "10", 
            ],
            "group": "build"
        },
        {
            "label": "Build - Debug",
            "command": "python3",
            "type": "shell",
            "args": [
                "${workspaceFolder}/scripts/build.py",
                "--type", 
                "Debug",
                "--target", 
                "build", 
                "--jobs",
                "10", 
            ],
            "group": "build"
        },
        {
            "label": "Rebuild - Debug",
            "command": "python3",
            "type": "shell",
            "args": [
                "${workspaceFolder}/scripts/build.py",
                "--type", 
                "Debug",
                "--target", 
                "rebuild", 
                "--jobs",
                "10", 
            ],
            "group": "build"
        }
    ]
}