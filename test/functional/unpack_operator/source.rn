// Unpack Operator

print(...[1, 2, 3]);
print(...[...[1, 2, 3]]);
print("test");
print(..."test");
print(...["one", "two", "three"]);
print(sum([...[...[...[...[...[...[...[1, 2, 3, 4, 5, 6, 7, 8]]]]]]]]));
print([...[...[...[...[...[...[...[1, 2, 3, 4, 5, 6, 7, 8]]]]]]]]);

routine foo(var a: int, var b: float, var c: string): string
begin
    return to_string(a) + to_string(b) + to_string(c);
end

var args: array = [99, 0.482, "++++++"];
print(foo(...args));